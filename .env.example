# Copy to .env and fill in. Values in the real environment take priority.

# ---------------------------------------------------------------- general
# Where renders and the job database live (default ~/.vauto)
# VAUTO_HOME=~/.vauto
# Platforms posted to when --platforms is not given
VAUTO_PLATFORMS=instagram,facebook,tiktok,youtube,snapchat
# Always add a Trial Reel to Instagram video posts (or pass --trial each time)
VAUTO_TRIAL_DEFAULT=false
# Minutes after the main Reel, picked at random in this range
VAUTO_TRIAL_DELAY=60-120
# MANUAL keeps trial reels away from followers; SS_PERFORMANCE lets Instagram share winners
VAUTO_TRIAL_GRADUATION=MANUAL

# Backend per platform: meta (direct, free) or zernio (unified API)
VAUTO_BACKEND_INSTAGRAM=meta
VAUTO_BACKEND_FACEBOOK=meta
# TikTok, YouTube and Snapchat always use zernio for now

# ---------------------------------------------------------------- Zernio (TikTok, YouTube, Snapchat)
# https://zernio.com/dashboard/api-keys ; run `vauto accounts` to get the account ids
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_TIKTOK=
ZERNIO_ACCOUNT_YOUTUBE=
ZERNIO_ACCOUNT_SNAPCHAT=
# Only needed if you switch Instagram/Facebook to the zernio backend
ZERNIO_ACCOUNT_INSTAGRAM=
ZERNIO_ACCOUNT_FACEBOOK=

TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
YOUTUBE_VISIBILITY=public
YOUTUBE_ADD_SHORTS_TAG=true
# spotlight | saved_story | story
SNAPCHAT_CONTENT_TYPE=spotlight

# ---------------------------------------------------------------- Meta direct (Instagram + Facebook)
# graph.facebook.com for Facebook Login tokens, graph.instagram.com for Instagram Login tokens
META_GRAPH_HOST=graph.facebook.com
META_GRAPH_VERSION=v23.0
IG_USER_ID=
IG_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------- storage for public media URLs
# auto: S3 if S3_BUCKET is set, else Zernio media hosting if ZERNIO_API_KEY is set
VAUTO_STORAGE=auto
# Cloudflare R2 example: S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public base URL (R2 public bucket or custom domain); otherwise presigned URLs are used
S3_PUBLIC_BASE_URL=
VAUTO_URL_TTL_HOURS=48

# ---------------------------------------------------------------- optional
# For --rewrite-captions (pip install 'vauto[claude]')
ANTHROPIC_API_KEY=
VAUTO_CAPTION_MODEL=claude-opus-5
# Font for Trial Reel hook text
# VAUTO_FONT=/path/to/font.ttf

# Where delayed Trial Reels go: auto uses Zernio's server-side scheduling when
# ZERNIO_ACCOUNT_INSTAGRAM is set (nothing needs to stay running), else the local queue.
VAUTO_TRIAL_BACKEND=auto
