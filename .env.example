# vauto settings. Copy to .env and fill in what you use; everything is optional.
# Values in your real environment take priority over this file.
# The web app (vauto web > Setup) edits the same file, and `vauto doctor` shows what is missing.

# Where renders, the job queue and saved logins live (default ~/.vauto)
# VAUTO_HOME=~/.vauto

# ======== General =====================================================
# Default platforms: comma-separated, e.g. instagram,facebook,tiktok,youtube,snapchat
VAUTO_PLATFORMS=instagram,facebook,tiktok,youtube,snapchat
# Time zone: e.g. Europe/London
VAUTO_TIMEZONE=Europe/London
# Best posting times: e.g. mon-fri 07:30,12:30,18:00; sat-sun 10:00
# VAUTO_BEST_TIMES=mon-fri 07:30,12:30,18:00,20:30; sat-sun 10:00,19:30
VAUTO_TRIAL_DEFAULT=false
# Trial Reel delay (minutes): e.g. 60-120
VAUTO_TRIAL_DELAY=60-120
# Trial Reel graduation: MANUAL keeps it off followers' feeds; one of: MANUAL, SS_PERFORMANCE
VAUTO_TRIAL_GRADUATION=MANUAL
# Trial Reel route: auto uses Zernio scheduling when available; one of: auto, meta, zernio
VAUTO_TRIAL_BACKEND=auto
# Trial results check after (hours): default 72
VAUTO_TRIAL_REPORT_HOURS=72
# Refresh views and likes every (hours): default 6; 0 turns it off. Needs `vauto worker` (Docker runs it for you)
VAUTO_STATS_REFRESH_HOURS=6
# Summary message on Telegram: weekly (Monday 9am), daily, or off; one of: weekly, daily, off
VAUTO_DIGEST=weekly
# Keep rendered videos for (days): default 14; older renders, uploads and hand-off files are deleted (thumbnails stay). 0 keeps everything
VAUTO_KEEP_FILES_DAYS=14

# ======== Zernio (TikTok, YouTube, Snapchat and more) =================
# API key: zernio.com > Dashboard > API keys
ZERNIO_API_KEY=
# Profile id: optional, for best-time analytics
ZERNIO_PROFILE_ID=
# Instagram account id: from `vauto accounts`
ZERNIO_ACCOUNT_INSTAGRAM=
# Facebook account id: from `vauto accounts`
ZERNIO_ACCOUNT_FACEBOOK=
# TikTok account id: from `vauto accounts`
ZERNIO_ACCOUNT_TIKTOK=
# YouTube account id: from `vauto accounts`
ZERNIO_ACCOUNT_YOUTUBE=
# Snapchat account id: from `vauto accounts`
ZERNIO_ACCOUNT_SNAPCHAT=
# Threads account id: from `vauto accounts`
ZERNIO_ACCOUNT_THREADS=
# X account id: from `vauto accounts`
ZERNIO_ACCOUNT_X=
# LinkedIn account id: from `vauto accounts`
ZERNIO_ACCOUNT_LINKEDIN=
# Pinterest account id: from `vauto accounts`
ZERNIO_ACCOUNT_PINTEREST=
# Bluesky account id: from `vauto accounts`
ZERNIO_ACCOUNT_BLUESKY=
# Telegram account id: from `vauto accounts`
ZERNIO_ACCOUNT_TELEGRAM=
# Reddit account id: from `vauto accounts`
ZERNIO_ACCOUNT_REDDIT=
# Discord account id: from `vauto accounts`
ZERNIO_ACCOUNT_DISCORD=

# ======== Instagram and Facebook (direct) =============================
# Instagram route: empty = Meta direct when IG_USER_ID/IG_ACCESS_TOKEN are set, otherwise Zernio; one of: meta, zernio, handoff
VAUTO_BACKEND_INSTAGRAM=
# Facebook route: empty = Meta direct when FB_PAGE_ID/FB_PAGE_ACCESS_TOKEN are set, otherwise Zernio; one of: meta, zernio, handoff
VAUTO_BACKEND_FACEBOOK=
# Graph host: graph.facebook.com (Facebook Login) or graph.instagram.com; one of: graph.facebook.com, graph.instagram.com
META_GRAPH_HOST=graph.facebook.com
# Meta app id: only needed for `vauto auth meta` token exchange
META_APP_ID=
META_APP_SECRET=
# Instagram user id: `vauto auth meta` fills this in
IG_USER_ID=
# Instagram token: a Page token never expires
IG_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ======== TikTok ======================================================
# TikTok route: tiktok = free direct drafts; one of: zernio, tiktok, handoff
VAUTO_BACKEND_TIKTOK=zernio
# Privacy: one of: PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR, SELF_ONLY
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# Client key: developers.tiktok.com app, for direct drafts
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Redirect URI: the https URL registered in your TikTok app
TIKTOK_REDIRECT_URI=

# ======== YouTube and Snapchat ========================================
# YouTube visibility: one of: public, unlisted, private
YOUTUBE_VISIBILITY=public
YOUTUBE_ADD_SHORTS_TAG=true
# Snapchat post type: one of: spotlight, saved_story, story
SNAPCHAT_CONTENT_TYPE=spotlight

# ======== Telegram (bot, phone hand-off, channel) =====================
# Bot token: from @BotFather
TELEGRAM_BOT_TOKEN=
# Your chat id: where hand-offs and notifications go
TELEGRAM_OWNER_CHAT_ID=
# Allowed user ids: who may use the bot, comma-separated
TELEGRAM_ALLOWED_USER_IDS=
# Channel to post to: @channelname or -100… id; add the bot as admin
TELEGRAM_CHANNEL_ID=
# Bot API server: for phone videos over 20 MB: http://telegram-bot-api:8081 with the docker bigfiles profile
# TELEGRAM_API_BASE=http://telegram-bot-api:8081
# Telegram api_id: my.telegram.org > API development tools; for the big-files server
TELEGRAM_API_ID=
# Telegram api_hash: for the big-files server
TELEGRAM_API_HASH=

# ======== More platforms ==============================================
# Bluesky handle: e.g. you.bsky.social
BLUESKY_HANDLE=
# Bluesky app password: Settings > Privacy > App passwords
BLUESKY_APP_PASSWORD=
# Threads user id: only for the direct Threads route
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Mastodon instance: e.g. https://mastodon.social
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
# Subreddit: without r/
REDDIT_SUBREDDIT=
# Reddit flair id: if the subreddit requires one
REDDIT_FLAIR_ID=
# Pinterest board id: empty = first board
PINTEREST_BOARD_ID=
# Pinterest link: optional destination link on pins
PINTEREST_LINK=

# ======== Public media storage ========================================
# Storage: auto = S3 if set, else Zernio; one of: auto, zernio, s3, none
VAUTO_STORAGE=auto
S3_BUCKET=
# Endpoint URL: R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Region: auto for R2
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL: optional; otherwise links are presigned
S3_PUBLIC_BASE_URL=

# ======== Extras ======================================================
# Anthropic API key: for Claude caption rewriting
ANTHROPIC_API_KEY=
# Caption model: default claude-opus-5
VAUTO_CAPTION_MODEL=claude-opus-5
# Subtitle model: faster-whisper size: tiny, base, small, medium
VAUTO_SUBTITLE_MODEL=small
# Subtitle style: one of: bold, clean
VAUTO_SUBTITLE_STYLE=bold
# Subtitle language: empty = detect
VAUTO_SUBTITLE_LANGUAGE=
# Font for hook text: path to a .ttf
# VAUTO_FONT=/path/to/font.ttf
# social-auto-upload command: default sau
SAU_COMMAND=sau
# social-auto-upload account: default default
SAU_ACCOUNT=default
# Bilibili category id: default 160
BILIBILI_TID=160
VAUTO_BROWSER_HEADLESS=true
VAUTO_BROWSER_FALLBACK_HANDOFF=true
# Web app password: required when the app is reachable from other devices
VAUTO_WEB_PASSWORD=
# Phone address: the https address your phone uses, e.g. from `tailscale serve`
VAUTO_PUBLIC_URL=
